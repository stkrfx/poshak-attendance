@targetUserId = paste_employee_uuid_from_step_3_here

### 1. Bootstrap Initial Developer/Admin Account (Run Once)
POST {{baseUrl}}/api/v1/super/setup
Content-Type: application/json

{
  "setup_secret": "vH6u/jOP=q&.xxrJ}wyb%7t7GXs4Vgx-l/cA@>0XR(qqVyp>K=Lj@kySLHdRBmv?<BnyIt$CZC>uj?7!SM8ZpA",
