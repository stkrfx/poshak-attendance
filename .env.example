# Server Configuration
PORT=8080
ENV=development
TIMEZONE=Asia/Kolkata

# Neon PostgreSQL Connection URI
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/poshak_db?sslmode=require

# JWT Security Secrets (Use strong 64-character random strings in production)
USER_JWT_SECRET=replace_with_strong_employee_jwt_secret_key_64_chars
SUPER_JWT_SECRET=replace_with_strong_super_admin_jwt_secret_key_64_chars

# Initial Super User (Admin/Developer) Bootstrap Secret
SUPER_SETUP_SECRET=replace_with_one_time_bootstrap_secret

# Google Sheets v4 Configuration (Raw JSON string, NO file path)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account","project_id":"your_project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
SHEET_SYNC_INTERVAL_MINUTES=15

# Firebase Admin SDK Configuration for Phone OTP Verification (Raw JSON string, NO file path)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_firebase_project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Gmail SMTP Configuration (For Email 6-Digit OTP Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_shop_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_gmail_app_password
